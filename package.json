    "@angular/router": "^22.1.0",
    "@lucide/angular": "^1.43.0",
    "@ngneat/overview": "8.0.0",
    "@ngxpert/hot-toast": "^7.0.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.1.7",
    "@angular/cli": "^22.1.7",
